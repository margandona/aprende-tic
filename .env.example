# Configuración de Firebase para el frontend (I1b).
# Solo valores PÚBLICOS del SDK. Nunca claves privadas ni de Admin SDK.

# Modo emuladores (desarrollo/pruebas). En producción NO definir.
VITE_USE_EMULATORS=true

# Configuración real (obligatoria si VITE_USE_EMULATORS no es "true").
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_AUTH_DOMAIN=
