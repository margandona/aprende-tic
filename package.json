{
  "name": "red-tic-app",
  "version": "0.2.0-i0d",
  "private": true,
  "type": "module",
  "description": "RED-TIC — MVP (Vue 3 + Firebase): interfaz con fixtures y backend Firebase probado con emuladores.",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:install": "playwright install chromium",
    "build:functions": "npm --prefix functions run build",
    "emu:start": "npm run build:functions && firebase emulators:start --project demo-red-tic",
    "emu:test": "npm run build:functions && firebase emulators:exec --project demo-red-tic --only auth,firestore,storage,functions \"vitest run --config vitest.emu.config.ts\""
  },
  "dependencies": {
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@eslint/js": "^9.16.0",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@google-cloud/firestore": "^9.2.0",
    "@google-cloud/storage": "^8.2.0",
    "@playwright/test": "^1.49.1",
    "@types/node": "^26.6.3",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.16.0",
    "eslint-plugin-vue": "^9.32.0",
    "firebase": "^12.19.0",
    "firebase-admin": "^14.5.0",
    "firebase-tools": "^15.31.0",
    "jsdom": "^25.0.1",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.17.0",
    "vite": "^6.0.3",
    "vitest": "^3.2.7",
    "vue-tsc": "^2.1.10"
  }
}
