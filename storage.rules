rules_version = '2';

// RED-TIC · Storage Security Rules (I0e endurecido)
// Ruta: courses/{courseId}/enrollments/{enrollmentId}/deliveries/{deliveryId}/uploads/{reservationId}/{fileName}
// La creación exige una RESERVA real (uploadReservations/{reservationId}) que coteja
// curso, matrícula, entrega, propietario, nombre, MIME y tamaño. Además, vínculo activo.
service firebase.storage {
  match /b/{bucket}/o {

    function binding() {
      return firestore.get(/databases/(default)/documents/sessionBindings/$(request.auth.uid)).data;
    }
    function activeBinding() {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/sessionBindings/$(request.auth.uid))
        && binding() != null
        && binding().state == 'active'
        && binding().expiresAt > request.time;
    }
    function delivery(deliveryId) {
      return firestore.get(/databases/(default)/documents/deliveries/$(deliveryId)).data;
    }
    function reservation(id) {
      return firestore.get(/databases/(default)/documents/uploadReservations/$(id)).data;
    }
    function teacherOf(courseId) {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/teachers/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/teachers/$(request.auth.uid)).data.status == 'active'
        && firestore.exists(/databases/(default)/documents/teacherCourses/$(request.auth.uid + '_' + courseId));
    }
    function memberOf(teamId, enrollmentId) {
      return firestore.exists(/databases/(default)/documents/teams/$(teamId)/members/$(enrollmentId));
    }

    match /courses/{courseId}/enrollments/{enrollmentId}/deliveries/{deliveryId}/uploads/{reservationId}/{fileName} {
      allow read: if (
        (activeBinding()
          && binding().enrollmentId == enrollmentId
          && delivery(deliveryId) != null
          && delivery(deliveryId).ownerEnrollmentId == enrollmentId)
        || (activeBinding()
          && binding().courseId == courseId
          && delivery(deliveryId) != null
          && delivery(deliveryId).teamId != null
          && memberOf(delivery(deliveryId).teamId, binding().enrollmentId))
        || teacherOf(courseId)
      );

      allow create: if activeBinding()
        && binding().enrollmentId == enrollmentId
        && binding().courseId == courseId
        && delivery(deliveryId) != null
        && delivery(deliveryId).courseId == courseId
        && delivery(deliveryId).ownerEnrollmentId == enrollmentId
        && delivery(deliveryId).state in ['not_started', 'in_progress']
        && firestore.exists(/databases/(default)/documents/uploadReservations/$(reservationId))
        && reservation(reservationId) != null
        && reservation(reservationId).state == 'reserved'
        && reservation(reservationId).expiresAt > request.time
        && reservation(reservationId).courseId == courseId
        && reservation(reservationId).enrollmentId == enrollmentId
        && reservation(reservationId).deliveryId == deliveryId
        && reservation(reservationId).ownerEnrollmentId == enrollmentId
        && reservation(reservationId).fileName == fileName
        && reservation(reservationId).contentType == request.resource.contentType
        && reservation(reservationId).sizeBytes == request.resource.size
        && request.resource.size <= 5 * 1024 * 1024;

      allow update, delete: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
