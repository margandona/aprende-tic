rules_version = '2';

// RED-TIC · Firestore Security Rules (I0e endurecido)
// - Catálogo, cursos y equipos: solo con vínculo activo o docente autorizado y activo.
// - Reglas compatibles con consultas (usan resource.data y get()/exists() de OTROS documentos).
// - Escrituras sensibles: solo Functions (Admin SDK, que valida el actor internamente).
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────────
    function signedIn() { return request.auth != null; }
    function bindingPath() { return /databases/$(database)/documents/sessionBindings/$(request.auth.uid); }
    function binding() { return get(bindingPath()).data; }
    function activeBinding() {
      return signedIn()
        && exists(bindingPath())
        && binding() != null
        && binding().state == 'active'
        && binding().expiresAt > request.time;
    }
    function myEnrollmentId() { return activeBinding() ? binding().enrollmentId : 'none'; }
    function myCourseId() { return activeBinding() ? binding().courseId : 'none'; }

    function teacherPath(uid) { return /databases/$(database)/documents/teachers/$(uid); }
    function isActiveTeacher() {
      return signedIn() && exists(teacherPath(request.auth.uid))
        && get(teacherPath(request.auth.uid)).data.status == 'active';
    }
    function isTeacherOfCourse(courseId) {
      return isActiveTeacher()
        && exists(/databases/$(database)/documents/teacherCourses/$(request.auth.uid + '_' + courseId));
    }
    function canReadDeliveryData(d) {
      return (activeBinding() && d.ownerEnrollmentId == myEnrollmentId())
        || (activeBinding() && binding().courseId == d.courseId && d.teamId != null
            && exists(/databases/$(database)/documents/teams/$(d.teamId)/members/$(myEnrollmentId())))
        || isTeacherOfCourse(d.courseId);
    }

    // ── Catálogo: solo sesión vinculada o docente activo ─────────────────
    match /institutions/{id} { allow read: if activeBinding() || isActiveTeacher(); allow write: if false; }
    match /programVersions/{id} { allow read: if activeBinding() || isActiveTeacher(); allow write: if false; }
    match /missions/{id} { allow read: if activeBinding() || isActiveTeacher(); allow write: if false; }
    match /milestones/{id} { allow read: if activeBinding() || isActiveTeacher(); allow write: if false; }
    match /indicators/{id} { allow read: if activeBinding() || isActiveTeacher(); allow write: if false; }
    match /badges/{id} { allow read: if activeBinding() || isActiveTeacher(); allow write: if false; }

    match /courses/{id} {
      allow read: if isTeacherOfCourse(id) || (activeBinding() && id == myCourseId());
      allow write: if false;
    }

    // ── Identidad (no escribible desde el cliente) ───────────────────────
    match /teachers/{uid} { allow read: if signedIn() && request.auth.uid == uid; allow write: if false; }
    match /teacherCourses/{docId} {
      allow read: if signedIn() && resource.data.teacherUid == request.auth.uid;
      allow write: if false;
    }
    match /enrollments/{enrollmentId} {
      allow read: if (activeBinding() && enrollmentId == myEnrollmentId())
        || isTeacherOfCourse(resource.data.courseId);
      allow write: if false;
    }
    match /sessionBindings/{authUid} {
      allow read: if signedIn() && request.auth.uid == authUid;
      allow write: if false;
    }
    match /codeCredentials/{codeHash} { allow read, write: if false; }
    match /uploadReservations/{id} { allow read, write: if false; }
    match /redeemRate/{id} { allow read, write: if false; }
    match /auditLogs/{id} { allow read, write: if false; }

    // ── Equipos: solo miembros o docente del curso ───────────────────────
    match /teams/{teamId} {
      allow read: if (activeBinding() && exists(/databases/$(database)/documents/teams/$(teamId)/members/$(myEnrollmentId())))
        || isTeacherOfCourse(resource.data.courseId);
      allow write: if false;
      match /members/{enrollmentId} {
        allow read: if (activeBinding() && exists(/databases/$(database)/documents/teams/$(teamId)/members/$(myEnrollmentId())))
          || isTeacherOfCourse(get(/databases/$(database)/documents/teams/$(teamId)).data.courseId);
        allow write: if false;
      }
    }

    // ── Entregas y evidencias (lectura por rol/curso; escritura por Functions) ─
    match /deliveries/{deliveryId} {
      allow read: if canReadDeliveryData(resource.data);
      allow write: if false;
      match /evidence/{evidenceId} {
        allow read: if canReadDeliveryData(get(/databases/$(database)/documents/deliveries/$(deliveryId)).data);
        allow write: if false;
      }
      match /contributors/{enrollmentId} {
        allow read: if canReadDeliveryData(get(/databases/$(database)/documents/deliveries/$(deliveryId)).data);
        allow write: if false;
      }
      match /checklistConfirmations/{confirmationId} {
        allow read: if canReadDeliveryData(get(/databases/$(database)/documents/deliveries/$(deliveryId)).data);
        allow write: if false;
      }
    }

    // ── Evaluación y gamificación ────────────────────────────────────────
    match /assessments/{assessmentId} {
      allow read: if (activeBinding() && resource.data.enrollmentId == myEnrollmentId())
        || isTeacherOfCourse(resource.data.courseId);
      allow write: if false;
    }
    match /assessmentHistory/{id} {
      allow read: if (activeBinding() && resource.data.enrollmentId == myEnrollmentId())
        || isTeacherOfCourse(resource.data.courseId);
      allow write: if false;
    }
    match /deliveryHistory/{id} {
      allow read: if isTeacherOfCourse(resource.data.courseId);
      allow write: if false;
    }
    match /xpEvents/{id} {
      allow read: if (activeBinding() && resource.data.enrollmentId == myEnrollmentId())
        || isTeacherOfCourse(resource.data.courseId);
      allow write: if false;
    }
    match /badgeAwards/{id} {
      allow read: if (activeBinding() && resource.data.enrollmentId == myEnrollmentId())
        || isTeacherOfCourse(resource.data.courseId);
      allow write: if false;
    }

    // ── Diagnóstico (inmutable; escritura por Functions) ─────────────────
    match /diagnosisAttempts/{attemptId} {
      allow read: if (activeBinding() && resource.data.enrollmentId == myEnrollmentId())
        || isTeacherOfCourse(resource.data.courseId);
      allow write: if false;
      match /responses/{taskCode} {
        allow read: if (activeBinding()
          && get(/databases/$(database)/documents/diagnosisAttempts/$(attemptId)).data.enrollmentId == myEnrollmentId())
          || isTeacherOfCourse(get(/databases/$(database)/documents/diagnosisAttempts/$(attemptId)).data.courseId);
        allow write: if false;
      }
    }

    // ── Encuesta de condiciones (escritura solo servidor; lectura propia/docente) ─
    match /conditionsSurveys/{enrollmentId} {
      allow read: if (activeBinding() && enrollmentId == myEnrollmentId())
        || isTeacherOfCourse(resource.data.courseId);
      allow write: if false;
    }

    // ── Historial de revisión del diagnóstico (solo docente del curso) ───
    match /diagnosisReviewHistory/{id} {
      allow read: if isTeacherOfCourse(resource.data.courseId);
      allow write: if false;
    }

    // ── Códigos docentes de demostración (solo servidor) ─────────────────
    match /teacherDemoCodes/{id} { allow read, write: if false; }

    match /{document=**} { allow read, write: if false; }
  }
}
